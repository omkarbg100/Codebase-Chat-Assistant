# Root .gitignore

# Environment files with real secrets — NEVER commit these
.env
*.env.local

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python & Virtual Environments
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class

# Node Dependencies & Builds
node_modules/
dist/
dist-ssr/

# AI Service Local Artifacts & Vector DB
temp_repos/
chroma_db/
.temp_repos/
.chroma_db/
**/temp_repos/
**/chroma_db/
**/venv/
**/__pycache__/

