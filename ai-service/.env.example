# ─────────────────────────────────────────────────────────────────────
# LLM Provider: 'ollama' | 'gemini' | 'groq' | 'auto'
# Default is 'ollama' for local-first usage.
# ─────────────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama

# ─── Ollama (local) ──────────────────────────────────────────────────
# Base URL of your running Ollama server
OLLAMA_BASE_URL=http://localhost:11434
# Model name as shown in `ollama list` — prefixed with 'ollama/' for LiteLLM
OLLAMA_MODEL=ollama/llama3.2

# ─── Google Gemini (cloud) ────────────────────────────────────────────
# Obtain from https://aistudio.google.com
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini/gemini-2.5-flash

# ─── Groq (cloud) ────────────────────────────────────────────────────
# Obtain from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/llama-3.3-70b-versatile

# ─── ChromaDB ────────────────────────────────────────────────────────
# Uncomment if running a standalone Chroma container
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# ─── Hybrid Search tuning (optional) ─────────────────────────────────
# HYBRID_DENSE_WEIGHT=0.5
# HYBRID_SPARSE_WEIGHT=0.5
# HYBRID_RRF_K=60
# RETRIEVER_K=6
