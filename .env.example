# ──────────────────────────────────────────────
# Shared environment variables for docker-compose
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# MongoDB Atlas connection string
MONGODB_URI=mongodb://user:password@host/?ssl=true&...

# JWT secret key
JWT_SECRET=your_jwt_secret_here

# Google Gemini API key (used by server and ai-service)
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq API key (optional for fast Groq inference & failover)
GROQ_API_KEY=your_groq_api_key_here

# Active LLM provider for ai-service: 'gemini' | 'groq' | 'auto'
LLM_PROVIDER=gemini

