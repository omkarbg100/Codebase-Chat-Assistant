# ──────────────────────────────────────────────
# Shared environment variables for docker-compose
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# MongoDB Atlas or local connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/codebase_chat?retryWrites=true&w=majority

# JWT secret key for signing auth tokens
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Google Gemini API key (https://aistudio.google.com)
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq API key (optional for fast Groq inference & failover - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Active LLM provider for ai-service: 'gemini' | 'groq' | 'auto'
LLM_PROVIDER=gemini

# Model configurations (routed via LiteLLM)
GEMINI_MODEL=gemini/gemini-2.5-flash
GROQ_MODEL=groq/llama-3.3-70b-versatile

# Hybrid Search tuning (optional)
HYBRID_DENSE_WEIGHT=0.5
HYBRID_SPARSE_WEIGHT=0.5
HYBRID_RRF_K=60
RETRIEVER_K=6
